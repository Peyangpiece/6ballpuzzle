{
  "name": "6ballpuzzle",
  "version": "1.0.0",
  "private": true,
  "description": "6ball: browser two-player falling-ball puzzle (HEXDROP runtime)",
  "scripts": {
    "check": "node tools/check-syntax.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o public/tailwind.css --minify",
    "build": "npm run build:css && node tools/build.js",
    "test": "node tests/run-ci.js",
    "test:browser": "node tests/browser-smoke.js",
    "test:rules": "node tests/firebase-rules.js",
    "serve": "node tools/serve.js public",
    "serve:dist": "node tools/serve.js dist",
    "docs:layers": "node tools/layer-map.js > docs/ARCHITECTURE.generated.md",
    "lint": "node tools/lint.js",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-scope": "9.1.2",
    "estraverse": "5.3.0",
    "globals": "17.13.0",
    "playwright": "1.64.0",
    "tailwindcss": "3.4.19"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3"
  }
}
